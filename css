/* ---------- Base ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: "Segoe UI", sans-serif;
    color: white;
    overflow-x: hidden;
    background: linear-gradient(
        -45deg,
        #0f172a,
        #1e1b4b,
        #312e81,
        #0f172a
    );
    background-size: 400% 400%;
    animation: gradientFlow 15s ease infinite;
}

/* ---------- Animated Background ---------- */

@keyframes gradientFlow {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}

.orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    z-index: -1;
    animation: float 15s ease-in-out infinite;
}

.orb1 {
    width: 400px;
    height: 400px;
    background: #00d4ff;
    top: -120px;
    left: -120px;
}

.orb2 {
    width: 500px;
    height: 500px;
    background: #8b5cf6;
    top: 20%;
    right: -150px;
}

.orb3 {
    width: 350px;
    height: 350px;
    background: #ec4899;
    bottom: -100px;
    left: 30%;
}

@keyframes float {
    0%,100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(40px);
    }
}

/* ---------- Header ---------- */

header {
    text-align: center;
    padding: 5rem 1rem 3rem;
}

header h1 {
    font-size: 4rem;
    font-weight: 800;
    background: linear-gradient(
        90deg,
        #60a5fa,
        #c084fc,
        #f472b6
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    text-shadow:
        0 0 30px rgba(96, 165, 250, .4);
}

header p {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: rgba(255,255,255,.75);
}

/* ---------- Main ---------- */

main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
}

/* ---------- Glass Card ---------- */

.glass-card {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    border: 1px solid rgba(255,255,255,0.15);

    border-radius: 24px;
    padding: 2rem;

    box-shadow:
        0 8px 32px rgba(0,0,0,0.3),
        0 0 40px rgba(99,102,241,0.15);

    transition: all .3s ease;
}

.glass-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 15px 45px rgba(0,0,0,.4),
        0 0 60px rgba(99,102,241,.3);
}

.glass-card h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
}

.glass-card p {
    color: rgba(255,255,255,.75);
}

/* ---------- Survey ---------- */

.survey-container {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
}

iframe {
    border: none;
    border-radius: 18px;
    background: white;

    box-shadow:
        0 0 25px rgba(255,255,255,.1);
}

/* ---------- Mobile ---------- */

@media(max-width:768px) {

    header h1 {
        font-size: 2.5rem;
    }

    iframe {
        width: 100%;
        height: 700px;
    }

    .glass-card {
        padding: 1.5rem;
    }
}

textarea {
    width: 100%;
    min-height: 120px;
    margin-top: 1rem;
    padding: 1rem;

    background: rgba(255,255,255,0.08);
    color: white;

    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;

    resize: vertical;
    font-family: inherit;
}

textarea:focus {
    outline: none;
    border-color: #60a5fa;
    box-shadow: 0 0 15px rgba(96,165,250,.4);
}

button {
    margin-top: 1rem;
    padding: .8rem 1.5rem;

    border: none;
    border-radius: 12px;

    cursor: pointer;

    font-size: 1rem;
    font-weight: 600;

    background: linear-gradient(
        135deg,
        #60a5fa,
        #8b5cf6
    );

    color: white;

    transition: all .3s ease;
}

button:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(96,165,250,.5);
}

#surveyContainer {
    margin-top: 2rem;
    min-height: 500px;
}

.placeholder {
    opacity: 0.7;
    text-align: center;
    padding: 3rem;
}
